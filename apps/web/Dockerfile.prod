# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# BrewCult Web — production image (Next.js standalone output; Node 22,
# multi-stage, non-root; EF §7.2). Build context is the REPO ROOT.
#
# Assumes (documented layout — apps/web sources land with Lane A/Wave 2):
#   - root package.json + package-lock.json with `apps/web` + `packages/shared-types` workspaces
#   - next.config sets `output: "standalone"` (emits apps/web/.next/standalone/…/server.js)
#   - NEXT_PUBLIC_* values are BUILD-time — passed as args from compose
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/shared-types/package.json packages/shared-types/
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG API_INTERNAL_URL=http://api:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    API_INTERNAL_URL=$API_INTERNAL_URL
COPY --from=deps /app /app
COPY . .
RUN npm --workspace apps/web run build

FROM node:22-alpine AS runtime
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000
WORKDIR /app
COPY --from=builder --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=node:node /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
