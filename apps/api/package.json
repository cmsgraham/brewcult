{
  "name": "@brewcult/api",
  "version": "0.1.0",
  "private": true,
  "description": "BrewCult HTTP API (Fastify) + worker/scheduler entrypoints (EF §7.2)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "scheduler:dev": "tsx watch src/scheduler.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:grant": "tsx src/cli/admin.ts grant",
    "admin:list": "tsx src/cli/admin.ts list"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@brewcult/shared-types": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/oauth2": "^8.2.0",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.4",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
