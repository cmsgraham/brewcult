# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# BrewCult API — production image (Node 22, multi-stage, non-root; EF §7.2).
#
# This ONE image serves three deployables (role-based containers, same code):
#   api        → CMD default            → node dist/index.js
#   worker     → compose `command:`     → node dist/worker.js
#   scheduler  → compose `command:`     → node dist/scheduler.js
# There is deliberately NO separate worker.Dockerfile — the overrides live in
# infra/docker-compose.prod.yml. Build context is the REPO ROOT (npm workspaces).
#
# Assumes (documented layout — apps/api sources land with Lane A/Wave 2):
#   - root package.json + package-lock.json with `apps/api` + `packages/shared-types` workspaces
#   - `npm --workspace apps/api run build` emits apps/api/dist/{index,worker,scheduler}.js
# ─────────────────────────────────────────────────────────────────────────────

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared-types/package.json packages/shared-types/
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app /app
COPY . .
RUN npm --workspace apps/api run build \
 && npm prune --omit=dev

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/packages ./packages
COPY --from=builder --chown=node:node /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=node:node /app/apps/api/dist ./apps/api/dist
USER node
WORKDIR /app/apps/api
EXPOSE 4000
# Graceful SIGTERM drain is the app's job (EF §7.2) — node receives signals
# directly (no npm wrapper), so no signal-proxy shim is needed.
CMD ["node", "dist/index.js"]
