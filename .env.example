# BrewCult environment template (deployment_guide.md §9)
#
# cp .env.example .env  → fill the few required values → cd infra && docker compose up
# Zentra pattern: an EMPTY default means the feature is CLEANLY DISABLED, not broken.
# Prod values live in /srv/brewcult/.env.prod on the server (ADR-003) — never in the repo.
# DoD: adding a variable anywhere without adding it here + the guide fails code review.

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production
APP_URL=http://localhost:3000   # public web origin (prod: https://brewcult.coffee)
API_URL=http://localhost:4000   # public api origin (prod: https://brewcult.coffee/api)
JWT_SECRET=                     # 64 random bytes (e.g. `openssl rand -hex 64`); rotate per runbook
COOKIE_DOMAIN=localhost         # cookie scope (prod: brewcult.coffee)
# Refresh-cookie path AS THE BROWSER SEES IT. Caddy and the Next dev rewrite
# both strip /api before Fastify, so the API routes /v1/auth/* while the browser
# requests /api/v1/auth/*. Cookie path matching happens in the browser, so this
# must be the public form or the refresh cookie is never sent and sessions die
# 15 minutes after login. Only change it if the API moves off the /api prefix.
AUTH_COOKIE_PATH=/api/v1/auth

# ── Database / cache / storage ───────────────────────────────────────────────
# In-network hostnames (postgres/redis/minio) — containers resolve them on the
# compose network. From the HOST, Postgres is at localhost:5433 (dev port map).
DATABASE_URL=postgres://brewcult:brewcult@postgres:5432/brewcult  # Postgres 16 + pgvector
REDIS_URL=redis://redis:6379                                      # cache / rate limits / queues
S3_ENDPOINT=http://minio:9000                                     # S3-compatible endpoint (MinIO in Phase 1)
S3_ACCESS_KEY=minioadmin                                          # MinIO root user in dev; real creds in prod
S3_SECRET_KEY=minioadmin                                          # MinIO root password in dev
S3_BUCKET=brewcult-media                                          # created by infra/minio-create-bucket.sh
MEDIA_BASE_URL=http://localhost:9000/brewcult-media               # public media base (prod: https://media.brewcult.coffee)

# ── Auth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=               # empty → Google sign-in button hidden (conditional registration)
GOOGLE_CLIENT_SECRET=           # from Google Cloud Console (§7.2 runbook)
ADMIN_EMAILS=                   # comma-separated bootstrap admin allowlist (Zentra pattern)

# ── Mail (empty SMTP_HOST → mailer no-ops; dev uses the mailpit container) ───
SMTP_HOST=mailpit               # dev: mailpit catcher (UI http://localhost:8025); prod: mail.brewcult.coffee
SMTP_PORT=1025                  # dev: mailpit SMTP; prod: 587 (STARTTLS)
SMTP_SECURE=false               # false = STARTTLS/plain; true = implicit TLS (465)
SMTP_USER=                      # prod: app@brewcult.coffee (§8.1 step 4); empty in dev
SMTP_PASS=                      # prod: SMTP credential; empty in dev
SMTP_FROM=BrewCult <noreply@brewcult.coffee>   # From header for transactional mail
MAIL_ALLOWLIST=                 # staging guard, e.g. *@brewcult.coffee — empty in dev AND prod

# ── AI ───────────────────────────────────────────────────────────────────────
# Which AiProvider implementation the intelligence module uses.
# 'anthropic' is the reference implementation the prompts and injection evals
# were tuned against; 'openai' is the adapter behind the same seam.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=              # empty → AI features cleanly disabled
AI_DAILY_TOKEN_BUDGET_FREE=     # per-user daily token cap for the free tier (AI-10)

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=                     # empty → error tracking disabled

# ── Compose-only (read by infra/docker-compose.prod.yml, not by app code) ────
# Must agree with the credentials inside DATABASE_URL.
POSTGRES_USER=brewcult          # prod postgres container superuser
POSTGRES_PASSWORD=brewcult      # dev-safe default — CHANGE in .env.prod
POSTGRES_DB=brewcult            # database name
NEXT_PUBLIC_API_URL=            # web build arg; empty → same-origin /api via Caddy (recommended)

# Only read when AI_PROVIDER=openai. Model ids are provider-specific, so the
# §16.1 tiers are translated: default -> OPENAI_MODEL_DEFAULT, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-4.1
OPENAI_MODEL_PREMIUM=gpt-5
OPENAI_MODEL_CLASSIFY=gpt-4.1-mini

# --- notifications ----------------------------------------------------------
# The weekly recap sweep. Runs hourly rather than at a fixed weekly instant:
# the scheduler has no cron and no leader election and is restarted by every
# deploy, so a single-instant trigger would be missed by whichever restart
# straddled it. The delivery ledger keys on the ISO week, so sweeping often is
# free — the first pass of a week sends, every later pass is a no-op.
SCHEDULER_RECAP=1
SCHEDULER_RECAP_SWEEP_MS=3600000

# --- search presence --------------------------------------------------------
# Token from Search Console's "HTML tag" verification method. Unset emits no
# tag at all, which is correct: an empty verification meta FAILS verification
# rather than being ignored.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Official brand profiles for the Organization entity's schema.org `sameAs`,
# comma-separated absolute https URLs. Empty until the accounts exist — sameAs
# asserts these profiles are OURS, so listing one we do not control is a false
# claim about somebody else's account.
NEXT_PUBLIC_BRAND_PROFILES=
