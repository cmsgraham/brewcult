{
  "name": "brewcult",
  "version": "0.1.0",
  "private": true,
  "description": "BrewCult monorepo — brewing intelligence platform (apps/api, apps/web, packages/*)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @brewcult/api\" \"npm run dev -w @brewcult/web\"",
    "lint": "eslint . --max-warnings 0 && npm run lint:boundaries",
    "lint:boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "brand:export": "npm run export -w @brewcult/brand-tools",
    "seed": "npm run seed -w @brewcult/seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0"
  }
}
